// ============= SEATING PLAN GENERATION =============
function generateSeatingPlan() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    clearOldSeatingOutputs_(ss);
    Logger.log('=== Starting Seating Plan Generation ===');
    
    const controlData = readControlPanel(ss);
    const students = getEligibleStudents(ss, controlData);
    
    if (students.length === 0) {
      SpreadsheetApp.getUi().alert('No students found for the selected date and session!');
      return;
    }
    
    const rooms = readRoomData(ss);
    const subjectGroups = groupStudentsBySubject(students);
    const seatingPlan = allocateSeats(subjectGroups, rooms, controlData.maxSubjectsPerRoom);  // ← ADDED parameter
    
    writeSeatingPlan(ss, seatingPlan, controlData);
    writeEachRoomAsSeparateSheet(ss, seatingPlan, controlData);
    
    if (controlData.folderId) {
      exportSheetsToDriveFolder(ss, seatingPlan, controlData);
    }
    
    SpreadsheetApp.getUi().alert('✓ Seating Plan Generated Successfully!\n\n' +
      'Total Students: ' + students.length + '\n' +
      'Rooms Used: ' + seatingPlan.length);
    
    Logger.log('=== Seating Plan Generation Complete ===');
    
  } catch (error) {
    Logger.log('ERROR: ' + error.toString());
    SpreadsheetApp.getUi().alert('Error: ' + error.toString());
  }
}

function readControlPanel(ss) {
  const sheet = ss.getSheetByName(CONFIG.CONTROL_SHEET);
  const maxSubjectsCell = sheet.getRange(CONFIG.CONTROL_CELLS.MAX_SUBJECTS_PER_ROOM).getValue();
  const maxSubjectsPerRoom = maxSubjectsCell && !isNaN(parseInt(maxSubjectsCell)) ? parseInt(maxSubjectsCell) : null;
  
  return {
    examDate: sheet.getRange(CONFIG.CONTROL_CELLS.EXAM_DATE).getValue(),
    session: sheet.getRange(CONFIG.CONTROL_CELLS.SESSION).getValue(),
    examTitle: sheet.getRange(CONFIG.CONTROL_CELLS.EXAM_TITLE).getValue(),
    folderId: sheet.getRange(CONFIG.CONTROL_CELLS.FOLDER_ID).getValue(),
    maxSubjectsPerRoom: maxSubjectsPerRoom  // ← NEW: null = unlimited
  };
}

function getEligibleStudents(ss, controlData) {
  const sheet = ss.getSheetByName(CONFIG.STUDENT_SHEET);
  const data = sheet.getDataRange().getValues();
  const students = [];
  const targetDate = formatDate(controlData.examDate);
  const targetSession = controlData.session.toString().trim().toUpperCase();
  
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (!row[CONFIG.STUDENT_COLS.ROLL_NO]) continue;
    
    const examDate = formatDate(row[CONFIG.STUDENT_COLS.EXAM_DATE]);
    const session = row[CONFIG.STUDENT_COLS.SESSION].toString().trim().toUpperCase();
    
    if (examDate === targetDate && session === targetSession) {
      students.push({
        rollNo: row[CONFIG.STUDENT_COLS.ROLL_NO],
        section: row[CONFIG.STUDENT_COLS.Section],
        courseName: row[CONFIG.STUDENT_COLS.COURSE_NAME],
        subjectCode: row[CONFIG.STUDENT_COLS.SUBJECT_CODE],
        subjectName: row[CONFIG.STUDENT_COLS.SUBJECT_NAME],
        examDate: row[CONFIG.STUDENT_COLS.EXAM_DATE],
        session: row[CONFIG.STUDENT_COLS.SESSION]
      });
    }
  }
  return students;
}

function readRoomData(ss) {
  const sheet = ss.getSheetByName(CONFIG.ROOM_SHEET);
  const data = sheet.getDataRange().getValues();
  const rooms = [];
  
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (!row[CONFIG.ROOM_COLS.ROOM_NO]) continue;
    
    rooms.push({
      roomNo: row[CONFIG.ROOM_COLS.ROOM_NO],
      totalRows: parseInt(row[CONFIG.ROOM_COLS.TOTAL_ROWS]),
      totalColumns: parseInt(row[CONFIG.ROOM_COLS.TOTAL_COLUMNS]),
      capacity: parseInt(row[CONFIG.ROOM_COLS.TOTAL_ROWS]) * parseInt(row[CONFIG.ROOM_COLS.TOTAL_COLUMNS])
    });
  }
  return rooms;
}

function groupStudentsBySubject(students) {
  const groups = {};
  students.forEach(student => {
    const key = student.subjectCode;
    if (!groups[key]) groups[key] = [];
    groups[key].push(student);
  });
  return groups;
}

// ============= SEATING ALLOCATION =============
function allocateSeats(subjectGroups, rooms, maxSubjectsPerRoom) {  // ← ADDED parameter
  const seatingPlan = [];
  const subjects = Object.keys(subjectGroups).sort((a, b) => subjectGroups[b].length - subjectGroups[a].length);
  const subjectQueues = {};
  subjects.forEach(s => { subjectQueues[s] = subjectGroups[s].slice(); });

  let roomIndex = 0;

  while (hasRemainingStudents(subjectQueues)) {
    if (roomIndex >= rooms.length) {
      var remaining = getTotalRemainingStudents(subjectQueues);
      var refRoom = rooms[0];
      var gapCap = Math.ceil(refRoom.totalRows * refRoom.totalColumns / 2);
      var needed = roomIndex + Math.ceil(remaining / gapCap);
      throw new Error(
        'Not enough rooms! ' + remaining + ' students still unallocated. ' +
        'Need ' + needed + ' rooms total, but only ' + rooms.length + ' are available.'
      );
    }

    var room = rooms[roomIndex];
    var roomSeating = {
      roomNo: room.roomNo,
      totalRows: room.totalRows,
      totalColumns: room.totalColumns,
      seats: []
    };

    // *** NEW: Select subjects for this room (respecting limit if set) ***
    var roomSubjects = selectSubjectsForRoom(subjectQueues, maxSubjectsPerRoom);
    
    if (roomSubjects.length === 0) break;
    
    var largest = roomSubjects[0];
    var others = roomSubjects.slice(1);
    
    // Check if gap mode needed (only largest subject has students in selected batch)
    var gapMode = (others.length === 0 || !others.some(s => subjectQueues[s].length > 0));

    if (!gapMode) {
      var otherRoundRobin = 0;
      fillRoomAlternating(roomSeating, subjectQueues, largest, others, otherRoundRobin, room);
    } else {
      fillRoomWithGaps(roomSeating, subjectQueues[largest], room);
    }

    seatingPlan.push(roomSeating);
    roomIndex++;
  }
  return seatingPlan;
}

// *** NEW HELPER FUNCTION: Select subjects for current room ***
function selectSubjectsForRoom(subjectQueues, maxSubjectsPerRoom) {
  // Get all subjects that still have students
  var availableSubjects = Object.keys(subjectQueues)
    .filter(s => subjectQueues[s].length > 0)
    .sort((a, b) => subjectQueues[b].length - subjectQueues[a].length);
  
  // If no limit set (null/undefined), return all available subjects
  if (!maxSubjectsPerRoom) {
    return availableSubjects;
  }
  
  // Otherwise, return only up to the limit (Strategy A: Fill room completely with limited subjects)
  return availableSubjects.slice(0, maxSubjectsPerRoom);
}

// *** NEW HELPER FUNCTION: Count total remaining students ***
function getTotalRemainingStudents(subjectQueues) {
  return Object.values(subjectQueues).reduce((sum, queue) => sum + queue.length, 0);
}

function fillRoomAlternating(roomSeating, subjectQueues, largest, others, otherRoundRobin, room) {
  var currentRR = otherRoundRobin;
  for (var col = 1; col <= room.totalColumns; col++) {
    if (col % 2 === 1) {
      if (subjectQueues[largest].length > 0) {
        fillColumn(roomSeating, subjectQueues[largest], room, col);
      }
    } else {
      var usedOther = null;
      for (var a = 0; a < others.length; a++) {
        var idx = (currentRR + a) % others.length;
        if (subjectQueues[others[idx]].length > 0) {
          usedOther = others[idx];
          currentRR = (idx + 1) % others.length;
          break;
        }
      }
      if (usedOther) {
        for (var row = 1; row <= room.totalRows; row++) {
          if (subjectQueues[usedOther].length > 0) {
            var student = subjectQueues[usedOther].shift();
            roomSeating.seats.push({
              rollNo: student.rollNo,
              section: student.section,
              courseName: student.courseName,
              subjectCode: student.subjectCode,
              subjectName: student.subjectName,
              row: row,
              column: col,
              seatNo: 'R' + row + 'C' + col
            });
          }
        }
      }
    }
  }
  return currentRR;
}

function fillRoomWithGaps(roomSeating, studentQueue, room) {
  for (var col = 1; col <= room.totalColumns; col += 2) {
    for (var row = 1; row <= room.totalRows; row++) {
      if (studentQueue.length > 0) {
        var student = studentQueue.shift();
        roomSeating.seats.push({
          rollNo: student.rollNo,
          section: student.section,
          courseName: student.courseName,
          subjectCode: student.subjectCode,
          subjectName: student.subjectName,
          row: row,
          column: col,
          seatNo: 'R' + row + 'C' + col
        });
      } else return;
    }
  }
}

function fillColumn(roomSeating, queue, room, col) {
  for (var row = 1; row <= room.totalRows; row++) {
    if (queue.length > 0) {
      var student = queue.shift();
      roomSeating.seats.push({
        rollNo: student.rollNo,
        section: student.section,
        courseName: student.courseName,
        subjectCode: student.subjectCode,
        subjectName: student.subjectName,
        row: row,
        column: col,
        seatNo: 'R' + row + 'C' + col
      });
    }
  }
}

function hasRemainingStudents(subjectQueues) {
  return Object.values(subjectQueues).some(q => q.length > 0);
}

// ============= OUTPUT FUNCTIONS =============
function writeSeatingPlan(ss, seatingPlan, controlData) {
  let outputSheet = ss.getSheetByName(CONFIG.OUTPUT_SHEET);
  if (outputSheet) ss.deleteSheet(outputSheet);
  outputSheet = ss.insertSheet(CONFIG.OUTPUT_SHEET);
  
  outputSheet.getRange('A1').setValue(controlData.examTitle);
  outputSheet.getRange('A2').setValue('Date: ' + formatDate(controlData.examDate) + ' | Session: ' + controlData.session);
  outputSheet.getRange('A3').setValue('Generated on: ' + new Date().toLocaleString());
  
  let currentRow = 5;
  seatingPlan.forEach(room => {
    outputSheet.getRange(currentRow, 1).setValue('Room: ' + room.roomNo);
    outputSheet.getRange(currentRow, 3).setValue('Capacity: ' + room.totalRows + ' x ' + room.totalColumns);
    outputSheet.getRange(currentRow, 5).setValue('Occupied: ' + room.seats.length);
    currentRow += 2;
    
    const headers = ['Roll No', 'Student Name/Course', 'Subject Code', 'Row', 'Column', 'Seat No'];
    outputSheet.getRange(currentRow, 1, 1, headers.length).setValues([headers]);
    outputSheet.getRange(currentRow, 1, 1, headers.length).setFontWeight('bold').setBackground('#4a86e8').setFontColor('white');
    currentRow++;
    
    if (room.seats.length > 0) {
      const seatData = room.seats.map(seat => [
        seat.rollNo, seat.courseName, seat.subjectCode, seat.row, seat.column, seat.seatNo
      ]);
      outputSheet.getRange(currentRow, 1, seatData.length, headers.length).setValues(seatData);
      currentRow += seatData.length;
    }
    currentRow += 2;
  });
  
  outputSheet.autoResizeColumns(1, 6);
  outputSheet.setFrozenRows(3);
}

function writeEachRoomAsSeparateSheet(ss, seatingPlan, controlData) {
  seatingPlan.forEach(room => {
    const sheetName = room.roomNo.toString();
    let sheet = ss.getSheetByName(sheetName);
    if (sheet) ss.deleteSheet(sheet);
    sheet = ss.insertSheet(sheetName);

    sheet.getRange('A1').setValue(controlData.examTitle).setFontWeight('bold');
    sheet.getRange('A2').setValue('Date: ' + formatDate(controlData.examDate) + ' | Session: ' + controlData.session);
    sheet.getRange('A3').setValue('Room: ' + room.roomNo).setFontWeight('bold');

    const headerRow = 4, startRow = 5;
    const grid = Array.from({ length: room.totalRows + 1 }, () => Array(room.totalColumns).fill(''));
    const columnHeaders = Array(room.totalColumns).fill('');
    const columnCounts = Array(room.totalColumns).fill(0);
    const subjectTotals = {};
    const courseTotals = {};

    room.seats.forEach(seat => {
      const r = seat.row - 1, c = seat.column - 1;
      grid[r][c] = seat.rollNo;
      columnCounts[c]++;
      
      const subjectKey = `${seat.subjectName} (${seat.subjectCode})`;
      subjectTotals[subjectKey] = (subjectTotals[subjectKey] || 0) + 1;
      courseTotals[seat.courseName] = (courseTotals[seat.courseName] || 0) + 1;
      
      if (!columnHeaders[c]) columnHeaders[c] = subjectKey;
    });

    for (let c = 0; c < room.totalColumns; c++) {
      grid[room.totalRows][c] = columnCounts[c] || '';
    }

    sheet.getRange(headerRow, 1, 1, room.totalColumns).setValues([columnHeaders])
      .setFontWeight('bold')
      .setHorizontalAlignment('center')
      .setVerticalAlignment('middle')
      .setWrap(true)
      .setBackground('#eeeeee')
      .setBorder(true, true, true, true, true, true);

    const gridRange = sheet.getRange(startRow, 1, room.totalRows + 1, room.totalColumns);
    gridRange.setValues(grid)
      .setHorizontalAlignment('center')
      .setVerticalAlignment('middle')
      .setWrap(true)
      .setNumberFormat('@')
      .setBorder(true, true, true, true, true, true);

    sheet.getRange(startRow + room.totalRows, 1, 1, room.totalColumns)
      .setFontWeight('bold')
      .setBackground('#f3f3f3');

    let summaryStartRow = startRow + room.totalRows + 2;

    sheet.getRange(summaryStartRow, 1)
      .setValue('Course-wise Total:')
      .setFontWeight('bold')
      .setFontSize(11)
      .setBackground('#e6f2ff');
    
    summaryStartRow++;
    
    const subjectKeys = Object.keys(subjectTotals);
    let col = 1;
    let currentRow = summaryStartRow;
    
    subjectKeys.forEach((subject, index) => {
      if (col + 1 > room.totalColumns) {
        col = 1;
        currentRow++;
      }
      
      sheet.getRange(currentRow, col)
        .setValue(subject)
        .setWrap(true)
        .setFontWeight('bold')
        .setBackground('#fff2cc')
        .setBorder(true, true, true, true, true, true);
      
      sheet.getRange(currentRow, col + 1)
        .setValue(subjectTotals[subject])
        .setHorizontalAlignment('center')
        .setBackground('#fff2cc')
        .setBorder(true, true, true, true, true, true);
      
      col += 2;
    });

    summaryStartRow = currentRow + 2;

    sheet.getRange(summaryStartRow, 1)
      .setValue('Program-wise Total:')
      .setFontWeight('bold')
      .setFontSize(11)
      .setBackground('#e6f2ff');
    
    summaryStartRow++;
    
    const courseKeys = Object.keys(courseTotals);
    col = 1;
    currentRow = summaryStartRow;
    
    courseKeys.forEach((course, index) => {
      if (col + 1 > room.totalColumns) {
        col = 1;
        currentRow++;
      }
      
      sheet.getRange(currentRow, col)
        .setValue(course)
        .setWrap(true)
        .setFontWeight('bold')
        .setBackground('#d9ead3')
        .setBorder(true, true, true, true, true, true);
      
      sheet.getRange(currentRow, col + 1)
        .setValue(courseTotals[course])
        .setHorizontalAlignment('center')
        .setBackground('#d9ead3')
        .setBorder(true, true, true, true, true, true);
      
      col += 2;
    });

    summaryStartRow = currentRow + 2;

    sheet.getRange(summaryStartRow, 1)
      .setValue('Grand Total:')
      .setFontWeight('bold')
      .setBackground('#ffd966');

    sheet.getRange(summaryStartRow, 2)
      .setValue(room.seats.length)
      .setFontWeight('bold')
      .setHorizontalAlignment('center')
      .setBackground('#ffd966');

    for (let c = 1; c <= room.totalColumns; c++) {
      sheet.setColumnWidth(c, 150);
    }
    
    for (let r = startRow; r <= startRow + room.totalRows; r++) {
      sheet.setRowHeight(r, 55);
    }
    
    sheet.setFrozenRows(4);

    const lastUsedRow = summaryStartRow;
    const lastUsedCol = room.totalColumns;
    
    const totalSheetRows = sheet.getMaxRows();
    if (totalSheetRows > lastUsedRow) {
      sheet.deleteRows(lastUsedRow + 1, totalSheetRows - lastUsedRow);
    }
    
    const totalSheetCols = sheet.getMaxColumns();
    if (totalSheetCols > lastUsedCol) {
      sheet.deleteColumns(lastUsedCol + 1, totalSheetCols - lastUsedCol);
    }
  });
}

function exportSheetsToDriveFolder(ss, seatingPlan, controlData) {
  try {
    const folder = DriveApp.getFolderById(controlData.folderId);
    
    const dateStr = controlData.examDate.toString();
    const sessionStr = controlData.session.toString().trim();
    const fileName = dateStr + '_' + sessionStr;
    
    const spreadsheetFile = DriveApp.getFileById(ss.getId());
    const copiedFile = spreadsheetFile.makeCopy(fileName, folder);
    const copiedSS = SpreadsheetApp.openById(copiedFile.getId());
    
    const sheetsToKeep = [CONFIG.OUTPUT_SHEET, 'Master Sheet'];
    seatingPlan.forEach(room => {
      sheetsToKeep.push(room.roomNo.toString());
    });
    
    const allSheets = copiedSS.getSheets();
    allSheets.forEach(sheet => {
      const sheetName = sheet.getName();
      if (!sheetsToKeep.includes(sheetName)) {
        copiedSS.deleteSheet(sheet);
      }
    });
    
    SpreadsheetApp.flush();
    
    Logger.log('Spreadsheet exported to folder: ' + folder.getName() + ' as ' + fileName);
    SpreadsheetApp.getUi().alert('✓ Exported to Drive!\n\nFile: ' + fileName + '\nLocation: ' + folder.getName());
    
  } catch (error) {
    Logger.log('Export to folder failed: ' + error.toString());
    SpreadsheetApp.getUi().alert('Warning: Could not export to Drive folder.\n\nError: ' + error.toString() + '\n\nPlease check folder ID in Control Panel (B4).');
  }
}

// ============= GENERATE ATTENDANCE SHEETS =============
function generateAttendanceSheets() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    Logger.log('=== Starting Attendance Sheet Generation ===');
    
    const controlData = readControlPanel(ss);
    const students = getEligibleStudents(ss, controlData);
    
    if (students.length === 0) {
      SpreadsheetApp.getUi().alert('No students found for the selected date and session!');
      return;
    }
    
    const rooms = readRoomData(ss);
    const subjectGroups = groupStudentsBySubject(students);
    const seatingPlan = allocateSeats(subjectGroups, rooms, controlData.maxSubjectsPerRoom);  // ← ADDED parameter
    
    const studentNameMap = buildStudentNameMap(ss);
    const attendanceSheets = generateAttendanceSheetsData(seatingPlan, studentNameMap, controlData);
    
    if (controlData.folderId) {
      exportAttendanceToDrive(attendanceSheets, controlData);
    } else {
      SpreadsheetApp.getUi().alert('Please set Folder ID in Control Panel (B4) to export attendance sheets.');
      return;
    }
    
    SpreadsheetApp.getUi().alert('✓ Attendance Sheets Generated!\n\n' +
      'Total Sheets: ' + attendanceSheets.length + '\n' +
      'Location: Drive Folder');
    
    Logger.log('=== Attendance Sheet Generation Complete ===');
    
  } catch (error) {
    Logger.log('ERROR: ' + error.toString());
    SpreadsheetApp.getUi().alert('Error: ' + error.toString());
  }
}

// CHANGE 1: buildStudentNameMap now includes courseName
function buildStudentNameMap(ss) {
  const sheet = ss.getSheetByName(CONFIG.STUDENT_SHEET);
  const data = sheet.getDataRange().getValues();
  const nameMap = {};
  
  for (let i = 1; i < data.length; i++) {
    const rollNo = data[i][CONFIG.STUDENT_COLS.ROLL_NO];
    const name = data[i][CONFIG.STUDENT_COLS.Name];
    const section = data[i][CONFIG.STUDENT_COLS.Section];
    const courseName = data[i][CONFIG.STUDENT_COLS.COURSE_NAME];  // ← ADDED
    if (rollNo) {
      nameMap[rollNo] = { name: name, section: section, courseName: courseName };  // ← ADDED courseName
    }
  }
  
  return nameMap;
}

// CHANGE 2: generateAttendanceSheetsData now includes courseName in student records
function generateAttendanceSheetsData(seatingPlan, studentNameMap, controlData) {
  const attendanceSheets = [];
  
  seatingPlan.forEach(room => {
    const subjectGroups = {};
    
    room.seats.forEach(seat => {
      const key = seat.subjectCode;
      if (!subjectGroups[key]) {
        subjectGroups[key] = {
          subjectCode: seat.subjectCode,
          courseName: seat.courseName,
          subjectName: seat.subjectName,
          students: []
        };
      }
      const studentInfo = studentNameMap[seat.rollNo] || { name: 'N/A', section: '', courseName: '' };  // ← ADDED courseName
      subjectGroups[key].students.push({
        rollNo: seat.rollNo,
        name: studentInfo.name,
        section: studentInfo.section,
        courseName: studentInfo.courseName,  // ← ADDED
        seatNo: seat.seatNo
      });
    });
    
    Object.keys(subjectGroups).forEach(subjectCode => {
      const group = subjectGroups[subjectCode];
      
      group.students.sort((a, b) => {
        if (a.rollNo < b.rollNo) return -1;
        if (a.rollNo > b.rollNo) return 1;
        return 0;
      });
      
      attendanceSheets.push({
        roomNo: room.roomNo,
        subjectCode: group.subjectCode,
        courseName: group.courseName,
        subjectName: group.subjectName,
        students: group.students,
        examDate: controlData.examDate,
        session: controlData.session,
        examTitle: controlData.examTitle
      });
    });
  });
  
  return attendanceSheets;
}

function exportAttendanceToDrive(attendanceSheets, controlData) {
  const folder = DriveApp.getFolderById(controlData.folderId);
  
  const dateStr = controlData.examDate.toString();
  const sessionStr = controlData.session.toString().trim();
  const subfolderName = 'Attendance_' + dateStr + '_' + sessionStr;
  
  const subfolder = folder.createFolder(subfolderName);
  
  const attendanceSS = SpreadsheetApp.create('Attendance_' + dateStr + '_' + sessionStr);
  const attendanceFile = DriveApp.getFileById(attendanceSS.getId());
  
  subfolder.addFile(attendanceFile);
  DriveApp.getRootFolder().removeFile(attendanceFile);
  
  const defaultSheet = attendanceSS.getSheets()[0];
  
  attendanceSheets.forEach((sheetData, index) => {
    const sheetName = 'R' + sheetData.roomNo + '_' + sheetData.subjectCode;
    const sheet = attendanceSS.insertSheet(sheetName);
    writeAttendanceSheet(sheet, sheetData);
  });
  
  if (attendanceSS.getSheets().length > 1) {
