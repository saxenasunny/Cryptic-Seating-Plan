function writeMasterSheet(ss, seatingPlan, controlData) {
  const SHEET_NAME = 'Master Sheet';
  let masterSheet = ss.getSheetByName(SHEET_NAME);
  if (masterSheet) ss.deleteSheet(masterSheet);
  masterSheet = ss.insertSheet(SHEET_NAME);
  
  let row = 1;
  masterSheet.getRange(row, 1, 1, 8).merge().setValue(controlData.examTitle)
    .setFontWeight('bold').setFontSize(14).setHorizontalAlignment('center')
    .setBackground('#4a86e8').setFontColor('white');
  row++;
  
  masterSheet.getRange(row, 1, 1, 8).merge()
    .setValue('Date: ' + formatDate(controlData.examDate) + ' | Session: ' + controlData.session)
    .setFontWeight('bold').setFontSize(11).setHorizontalAlignment('center')
    .setBackground('#6fa8dc').setFontColor('white');
  row++;
  
  masterSheet.getRange(row, 1, 1, 8).merge()
    .setValue('Master Sheet - Generated: ' + new Date().toLocaleString())
    .setFontSize(9).setHorizontalAlignment('center').setBackground('#d9d9d9');
  row += 2;
  
  const headers = ['Room No', 'Capacity', 'Allocated', 'Remaining', 'Subjects', 'Subject-wise Roll No Range', 'Subject Count', 'Utilization %'];
  masterSheet.getRange(row, 1, 1, headers.length).setValues([headers])
    .setFontWeight('bold').setFontSize(10).setHorizontalAlignment('center')
    .setBackground('#434343').setFontColor('white')
    .setBorder(true, true, true, true, true, true);
  row++;
  
  const masterData = [];
  seatingPlan.forEach(room => {
    const roomCapacity = room.totalRows * room.totalColumns;
    const allocated = room.seats.length;
    const remaining = roomCapacity - allocated;
    
    const subjectsInRoom = [...new Set(room.seats.map(s => s.subjectCode))];
    
    const subjectRollNumbers = {};
    room.seats.forEach(seat => {
      if (!subjectRollNumbers[seat.subjectCode]) {
        subjectRollNumbers[seat.subjectCode] = [];
      }
      subjectRollNumbers[seat.subjectCode].push(seat.rollNo);
    });
    
    const subjectRanges = [];
    Object.keys(subjectRollNumbers).forEach(subjectCode => {
      const rolls = subjectRollNumbers[subjectCode].sort();
      const range = rolls[0] + ' - ' + rolls[rolls.length - 1];
      subjectRanges.push(subjectCode + ': ' + range);
    });
    const subjectRangeStr = subjectRanges.join('\n');
    
    const subjectCounts = {};
    room.seats.forEach(s => { 
      subjectCounts[s.subjectCode] = (subjectCounts[s.subjectCode] || 0) + 1; 
    });
    const subjectCountStr = Object.keys(subjectCounts).map(s => s + ': ' + subjectCounts[s]).join('\n');
    
    const utilization = ((allocated / roomCapacity) * 100).toFixed(1);
    
    masterData.push([
      room.roomNo, 
      roomCapacity, 
      allocated,
      remaining,
      subjectsInRoom.join(', '),
      subjectRangeStr,
      subjectCountStr, 
      utilization + '%'
    ]);
  });
  
  if (masterData.length > 0) {
    masterSheet.getRange(row, 1, masterData.length, headers.length).setValues(masterData)
      .setVerticalAlignment('middle').setWrap(true).setBorder(true, true, true, true, true, true);
    
    for (let i = 0; i < masterData.length; i++) {
      const bgColor = (i % 2 === 0) ? '#f3f3f3' : '#ffffff';
      masterSheet.getRange(row + i, 1, 1, headers.length).setBackground(bgColor);
    }
    row += masterData.length;
  }
  
  row += 2;
  const totalStudents = seatingPlan.reduce((sum, r) => sum + r.seats.length, 0);
  const totalCapacity = seatingPlan.reduce((sum, r) => sum + (r.totalRows * r.totalColumns), 0);
  const totalRemaining = totalCapacity - totalStudents;
  const overallUtilization = ((totalStudents / totalCapacity) * 100).toFixed(1);
  
  masterSheet.getRange(row, 1).setValue('SUMMARY').setFontWeight('bold').setFontSize(11).setBackground('#ffd966');
  row++;
  
  const summaryData = [
    ['Total Rooms:', seatingPlan.length],
    ['Total Students:', totalStudents],
    ['Total Capacity:', totalCapacity],
    ['Total Remaining:', totalRemaining],
    ['Utilization:', overallUtilization + '%']
  ];
  
  masterSheet.getRange(row, 1, summaryData.length, 2).setValues(summaryData)
    .setFontWeight('bold').setBackground('#fff2cc');
  
  masterSheet.setColumnWidth(1, 100);
  masterSheet.setColumnWidth(2, 100);
  masterSheet.setColumnWidth(3, 100);
  masterSheet.setColumnWidth(4, 100);
  masterSheet.setColumnWidth(5, 150);
  masterSheet.setColumnWidth(6, 250);
  masterSheet.setColumnWidth(7, 180);
  masterSheet.setColumnWidth(8, 110);
  masterSheet.setFrozenRows(5);
}

// ============= UTILITY FUNCTIONS =============
function formatDate(date) {
  if (date instanceof Date) {
    return Utilities.formatDate(date, Session.getScriptTimeZone(), 'M/d/yyyy');
  }
  return date.toString();
}

function parseExamDate(rawDate) {
  if (rawDate instanceof Date) return rawDate;
  if (typeof rawDate === "string") {
    const parts = rawDate.includes("/") ? rawDate.split("/") : rawDate.split("-");
    const day = parseInt(parts[0], 10);
    const month = parseInt(parts[1], 10) - 1;
    const year = parseInt(parts[2], 10);
    return new Date(year, month, day);
  }
  return null;
}

function clearOldSeatingOutputs_(ss) {
  const sheets = ss.getSheets();
  const protectedSheets = ["Students_Input", "Room Data", "Control Panel", "Program structure", 
                          "Student Details", "Date Sheet", "Master Sheet", "⚠ Exam_Clashes"];
  
  sheets.forEach(sh => {
    const name = sh.getName();
    if (name === CONFIG.OUTPUT_SHEET) {
      ss.deleteSheet(sh);
      return;
    }
    if (/^[A-Za-z0-9\-]+$/.test(name) && !protectedSheets.includes(name)) {
      ss.deleteSheet(sh);
    }
  });
}

