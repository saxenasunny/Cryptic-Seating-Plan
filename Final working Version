}

// *** NEW FUNCTION: Load duty history from Drive spreadsheet (for cumulative tracking) ***
function loadDutyHistoryFromDrive(config, folderId) {
  const SPREADSHEET_NAME = 'Duty Allocation Sheet';
  
  try {
    // Try to open existing Drive spreadsheet
    const folder = folderId ? DriveApp.getFolderById(folderId) : DriveApp.getRootFolder();
    const files = folder.getFilesByName(SPREADSHEET_NAME);
    
    if (!files.hasNext()) {
      Logger.log('No existing duty history found - starting fresh');
      return;
    }
    
    const file = files.next();
    const dutySpreadsheet = SpreadsheetApp.openById(file.getId());
    const sheets = dutySpreadsheet.getSheets();
    
    // Scan all session sheets (skip Faculty Summary)
    sheets.forEach(sheet => {
      const sheetName = sheet.getName();
      if (sheetName === 'Faculty Summary' || sheetName === 'Sheet1') return;
      
      const data = sheet.getDataRange().getValues();
      
      // Find the "ALLOCATED FACULTY" section
      for (let i = 0; i < data.length; i++) {
        const cellValue = String(data[i][0]);
        
        if (cellValue.includes('ALLOCATED FACULTY')) {
          // Skip header row
          i += 2;
          
          // Read duty records until we hit empty row or next section
          while (i < data.length && data[i][0] && !String(data[i][0]).includes('Total Faculty on Duty')) {
            const facultyName = data[i][3]; // Column D: Faculty Name
            const date = String(data[i][0]);
            const session = String(data[i][1]);
            const roomNo = data[i][2];
            
            const faculty = config.facultyByName[facultyName];
            if (faculty) {
              faculty.assignedDuties++;
              faculty.assignments.push({ date: date, session: session, roomNo: roomNo });
            }
            i++;
          }
          break;
        }
      }
    });
    
    const facultyWithDuties = Object.values(config.faculty).filter(f => f.assignedDuties > 0).length;
    Logger.log('Loaded duty history from Drive: ' + facultyWithDuties + ' faculty with cumulative duties');
    
  } catch (error) {
    Logger.log('Could not load duty history from Drive: ' + error.toString());
    Logger.log('Starting with fresh duty counts');
  }
}

function readDutyConfiguration(ss) {
  const config = { faculty: {}, facultyByName: {}, designationLimits: {}, invigilatorRules: [], unavailability: {} };
  
  const facultyData = ss.getSheetByName(DUTY_CONFIG.FACULTY_MASTER).getDataRange().getValues();
  for (let i = 1; i < facultyData.length; i++) {
    const row = facultyData[i];
    if (!row[1] || !row[0]) continue;
    const isAvailable = String(row[4]).toUpperCase().trim();
    if (isAvailable !== 'YES' && isAvailable !== 'Y' && isAvailable !== 'TRUE' && isAvailable !== '1') continue;
    
    const faculty = { name: row[0], empId: row[1], designation: row[2], department: row[3], assignedDuties: 0, assignments: [] };
    config.faculty[row[1]] = faculty;
    config.facultyByName[row[0]] = faculty;
  }
  
  const designationData = ss.getSheetByName(DUTY_CONFIG.DESIGNATION_CONFIG).getDataRange().getValues();
  for (let i = 1; i < designationData.length; i++) {
    if (designationData[i][0]) config.designationLimits[designationData[i][0]] = parseInt(designationData[i][1]);
  }
  
  const rulesData = ss.getSheetByName(DUTY_CONFIG.INVIGILATOR_RULES).getDataRange().getValues();
  for (let i = 1; i < rulesData.length; i++) {
    const row = rulesData[i];
    config.invigilatorRules.push({ minStudents: parseInt(row[0]), maxStudents: parseInt(row[1]), invigilatorsRequired: parseInt(row[2]) });
  }
  config.invigilatorRules.sort((a, b) => a.minStudents - b.minStudents);
  
  const unavailableSheet = ss.getSheetByName(DUTY_CONFIG.FACULTY_UNAVAILABLE);
  if (unavailableSheet) {
    const unavailableData = unavailableSheet.getDataRange().getValues();
    for (let i = 1; i < unavailableData.length; i++) {
      const row = unavailableData[i];
      if (row[0] && row[1] && row[2]) {
        config.unavailability[row[0] + '|' + formatDate(row[1]) + '|' + String(row[2]).toUpperCase().trim()] = true;
      }
    }
  }
  
  return config;
}

function readSeatingArrangement(ss) {
  const sheet = ss.getSheetByName(CONFIG.OUTPUT_SHEET);
  if (!sheet) return [];
  
  const data = sheet.getDataRange().getValues();
  const rooms = [];
  let currentDate = null, currentSession = null;
  
  for (let i = 0; i < data.length; i++) {
    const cellValue = String(data[i][0]);
    if (cellValue.includes('Date:')) {
      const parts = cellValue.split('|');
      if (parts.length >= 2) {
        currentDate = parts[0].replace('Date:', '').trim();
        currentSession = parts[1].replace('Session:', '').trim().toUpperCase();
      }
    }
    if (cellValue.includes('Room:')) {
      const roomNo = cellValue.replace('Room:', '').trim();
      const occupiedMatch = String(data[i][4]).match(/\d+/);
      const studentCount = occupiedMatch ? parseInt(occupiedMatch[0]) : 0;
      if (roomNo && studentCount > 0 && currentDate && currentSession) {
        rooms.push({ roomNo: roomNo, date: currentDate, session: currentSession, studentCount: studentCount });
      }
    }
  }
  return rooms;
}

function allocateDuties(seatingData, config) {
  const duties = [];
  const facultyPool = Object.values(config.faculty);
  seatingData.sort(() => Math.random() - 0.5);
  let totalDuties = 0;
  
  seatingData.forEach(room => {
    const invigilatorsNeeded = getInvigilatorsRequired(room.studentCount, config.invigilatorRules);
    if (invigilatorsNeeded === 0) return;
    
    const allocated = [];
    for (let i = 0; i < invigilatorsNeeded; i++) {
      const faculty = selectFaculty(facultyPool, room, config, allocated);
      if (!faculty) throw new Error('Insufficient available faculty for room ' + room.roomNo);
      
      allocated.push(faculty);
      faculty.assignedDuties++;
      faculty.assignments.push({ date: room.date, session: room.session, roomNo: room.roomNo });
      totalDuties++;
    }
    
    allocated.forEach(faculty => {
      duties.push({ date: room.date, session: room.session, roomNo: room.roomNo, facultyName: faculty.name, designation: faculty.designation, empId: faculty.empId });
    });
  });
  
  const summary = facultyPool.filter(f => f.assignedDuties > 0).map(f => ({
    facultyName: f.name, empId: f.empId, designation: f.designation, department: f.department,
    assignedDuties: f.assignedDuties, maxDuties: config.designationLimits[f.designation] || 0,
    remaining: (config.designationLimits[f.designation] || 0) - f.assignedDuties
  })).sort((a, b) => b.assignedDuties - a.assignedDuties);
  
  return { duties: duties, summary: summary, totalDuties: totalDuties };
}

function getInvigilatorsRequired(studentCount, rules) {
  for (let i = 0; i < rules.length; i++) {
    if (studentCount >= rules[i].minStudents && studentCount <= rules[i].maxStudents) return rules[i].invigilatorsRequired;
  }
  return 0;
}

function selectFaculty(facultyPool, room, config, alreadyAllocated) {
  const eligible = facultyPool.filter(faculty => {
    if (alreadyAllocated.includes(faculty)) return false;
    if (faculty.assignedDuties >= (config.designationLimits[faculty.designation] || 0)) return false;
    if (faculty.assignments.some(a => a.date === room.date && a.session === room.session)) return false;
    if (config.unavailability[faculty.name + '|' + room.date + '|' + room.session]) return false;
    return true;
  });
  if (eligible.length === 0) return null;
  eligible.sort(() => Math.random() - 0.5);
  eligible.sort((a, b) => a.assignedDuties - b.assignedDuties);
  return eligible[0];
}

// *** NEW FUNCTION: Write combined duty allocation to Drive ***
function writeCombinedDutyAllocationToDrive(allocation, config, seatingData, controlData) {
  const SPREADSHEET_NAME = 'Duty Allocation Sheet';
  const currentDate = seatingData[0].date;
  const currentSession = seatingData[0].session;
  const sheetName = formatDate(controlData.examDate) + '_' + controlData.session;
  
  // Get or create the Drive spreadsheet
  let dutySpreadsheet = getDutyAllocationSpreadsheet(SPREADSHEET_NAME, controlData.folderId);
  
  // Check if sheet with this date/session already exists
  let sheet = dutySpreadsheet.getSheetByName(sheetName);
  if (sheet) {
    dutySpreadsheet.deleteSheet(sheet);
  }
  
  // Create new sheet for this date/session
  sheet = dutySpreadsheet.insertSheet(sheetName);
  
  // Calculate available faculty
  const assignedFaculty = new Set();
  allocation.duties.forEach(duty => {
    if (duty.date === currentDate && duty.session === currentSession) {
      assignedFaculty.add(duty.facultyName);
    }
  });
  
  const availableFaculty = Object.values(config.faculty).filter(f => 
    !assignedFaculty.has(f.name) && 
    !config.unavailability[f.name + '|' + currentDate + '|' + currentSession]
  );
  availableFaculty.sort((a, b) => 
    a.designation !== b.designation ? 
    a.designation.localeCompare(b.designation) : 
    a.name.localeCompare(b.name)
  );
  
  // Write combined sheet
  writeCombinedDutySheet(sheet, allocation.duties, allocation.summary, availableFaculty, currentDate, currentSession, config);
  
  // *** ADD: Create/Update Faculty Summary sheet showing cumulative duties ***
  writeFacultySummaryToDrive(dutySpreadsheet, allocation.summary, config);
  
  Logger.log('Duty allocation saved to Drive: ' + SPREADSHEET_NAME + ' | Sheet: ' + sheetName);
}

// *** NEW FUNCTION: Get or create duty allocation spreadsheet in Drive ***
function getDutyAllocationSpreadsheet(spreadsheetName, folderId) {
  const folder = folderId ? DriveApp.getFolderById(folderId) : DriveApp.getRootFolder();
  
  // Search for existing spreadsheet
  const files = folder.getFilesByName(spreadsheetName);
  
  if (files.hasNext()) {
    const file = files.next();
    return SpreadsheetApp.openById(file.getId());
  } else {
    // Create new spreadsheet
    const newSpreadsheet = SpreadsheetApp.create(spreadsheetName);
    const newFile = DriveApp.getFileById(newSpreadsheet.getId());
    
    // Move to specified folder
    if (folderId) {
      folder.addFile(newFile);
      DriveApp.getRootFolder().removeFile(newFile);
    }
    
    return newSpreadsheet;
  }
}

