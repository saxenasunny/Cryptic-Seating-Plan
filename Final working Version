    .setValue('Last Updated: ' + new Date().toLocaleString())
    .setFontSize(9).setHorizontalAlignment('center').setBackground('#d9d9d9');
  row++;
  
  summarySheet.getRange(row, 1, 1, 7).merge()
    .setValue('Shows ALL available faculty and their cumulative duties across all sessions')
    .setFontSize(9).setHorizontalAlignment('center').setFontStyle('italic').setBackground('#f3f3f3');
  row += 2;
  
  // Column headers
  const headers = ['Faculty Name', 'Employee ID', 'Designation', 'Department', 'Assigned Duties', 'Max Duties', 'Remaining'];
  summarySheet.getRange(row, 1, 1, headers.length).setValues([headers])
    .setFontWeight('bold').setFontSize(10).setHorizontalAlignment('center')
    .setBackground('#434343').setFontColor('white')
    .setBorder(true, true, true, true, true, true);
  row++;
  
  // *** FIX: Include ALL available faculty (not just those with duties) ***
  const allFaculty = Object.values(config.faculty).map(f => ({
    facultyName: f.name,
    empId: f.empId,
    designation: f.designation,
    department: f.department,
    assignedDuties: f.assignedDuties || 0,
    maxDuties: config.designationLimits[f.designation] || 0,
    remaining: (config.designationLimits[f.designation] || 0) - (f.assignedDuties || 0)
  })).sort((a, b) => b.assignedDuties - a.assignedDuties || a.facultyName.localeCompare(b.facultyName));
  
  if (allFaculty.length > 0) {
    const summaryData = allFaculty.map(s => [
      s.facultyName, 
      s.empId, 
      s.designation,
      s.department,
      s.assignedDuties, 
      s.maxDuties, 
      s.remaining
    ]);
    
    summarySheet.getRange(row, 1, summaryData.length, headers.length)
      .setValues(summaryData)
      .setVerticalAlignment('middle')
      .setBorder(true, true, true, true, true, true);
    
    // Apply conditional formatting and alternating colors
    for (let i = 0; i < summaryData.length; i++) {
      const bgColor = (i % 2 === 0) ? '#ffffff' : '#f3f3f3';
      summarySheet.getRange(row + i, 1, 1, headers.length).setBackground(bgColor);
      
      // Highlight remaining capacity
      const remaining = allFaculty[i].remaining;
      if (remaining < 0) {
        // Over limit - RED
        summarySheet.getRange(row + i, 7).setBackground('#ff0000').setFontColor('white').setFontWeight('bold');
      } else if (remaining === 0) {
        // At limit - YELLOW
        summarySheet.getRange(row + i, 7).setBackground('#ffff00').setFontWeight('bold');
      } else if (remaining <= 2) {
        // Near limit - ORANGE
        summarySheet.getRange(row + i, 7).setBackground('#ffa500').setFontWeight('bold');
      }
    }
    
    row += summaryData.length;
  }
  
  row += 2;
  
  // Statistics
  const facultyWithDuties = allFaculty.filter(f => f.assignedDuties > 0);
  const totalAssigned = allFaculty.reduce((sum, s) => sum + s.assignedDuties, 0);
  const facultyCount = facultyWithDuties.length;
  const avgDuties = facultyCount > 0 ? (totalAssigned / facultyCount).toFixed(2) : 0;
  const overLimitCount = allFaculty.filter(s => s.remaining < 0).length;
  const atLimitCount = allFaculty.filter(s => s.remaining === 0).length;
  const availableCount = allFaculty.filter(s => s.remaining > 0 && s.assignedDuties === 0).length;
  
  summarySheet.getRange(row, 1)
    .setValue('STATISTICS')
    .setFontWeight('bold').setFontSize(11).setBackground('#ffd966');
  row++;
  
  const stats = [
    ['Total Available Faculty:', allFaculty.length],
    ['Faculty With Duties:', facultyCount],
    ['Faculty With Zero Duties:', availableCount],
    ['Total Duties Assigned:', totalAssigned],
    ['Average Duties (for assigned):', avgDuties],
    ['Faculty Over Limit:', overLimitCount],
