function resetDutyAllocation() {
  const ui = SpreadsheetApp.getUi();
  const response = ui.alert('Reset Duty Allocation', 'This will DELETE all existing duty assignments. Continue?', ui.ButtonSet.YES_NO);
  if (response !== ui.Button.YES) return;
  
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  [DUTY_CONFIG.DUTY_CHART, DUTY_CONFIG.FACULTY_SUMMARY].forEach(sheetName => {
    const sheet = ss.getSheetByName(sheetName);
    if (sheet) ss.deleteSheet(sheet);
  });
  ui.alert('✓ Duty allocation reset successfully!');
}
