}

function validateDutySheets(ss) {
  const requiredSheets = [DUTY_CONFIG.FACULTY_MASTER, DUTY_CONFIG.DESIGNATION_CONFIG, DUTY_CONFIG.INVIGILATOR_RULES];
  const missing = [];
  requiredSheets.forEach(sheetName => { if (!ss.getSheetByName(sheetName)) missing.push(sheetName); });
  if (missing.length > 0) throw new Error('Missing required sheets:\n' + missing.join('\n'));
}

function loadExistingDutyHistory(ss, config) {
