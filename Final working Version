function compileStudentSubjects_FAST() {
  const ss = SpreadsheetApp.getActive();
  const shStudents = ss.getSheetByName("Student Details");
  const shSubjects = ss.getSheetByName("Program structure");
  const shOut = ss.getSheetByName("Students_Input") || ss.insertSheet("Students_Input");

  const students = shStudents.getDataRange().getValues();
  const subjects = shSubjects.getDataRange().getValues();

  shOut.clear();
  const output = [["Roll_No", "Name", "Section", "Course_Name", "Subject_Code", "Subject_Name", "Exam_Date", "Session"]];
  const subjectMap = {};

  for (let i = 1; i < subjects.length; i++) {
    const program = subjects[i][0];
    const subjectName = subjects[i][1];
    const subjectCode = subjects[i][2];
    const batchYear = subjects[i][3];
    const examDate = subjects[i][4];
    const session = subjects[i][5];
    const key = program + "_" + batchYear;

    if (!subjectMap[key]) subjectMap[key] = [];
    subjectMap[key].push([program, subjectCode, subjectName, examDate, session]);
  }

  for (let i = 1; i < students.length; i++) {
    const rollNo = students[i][0];
    const name = students[i][1];
    const program = students[i][2];
    const batchYear = students[i][3];
    const section = students[i][4];
    const key = program + "_" + batchYear;

    if (subjectMap[key]) {
      subjectMap[key].forEach(sub =>
        output.push([rollNo, name, section, sub[0], sub[1], sub[2], sub[3], sub[4]])
      );
    }
  }

  shOut.getRange(1, 1, output.length, output[0].length).setValues(output);
  SpreadsheetApp.getUi().alert('✓ Student-Subject mapping complete!');
}

function detectExamClashes_FAST() {
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName("Students_Input");
  if (!sh) return;

  const data = sh.getDataRange().getValues();
  if (data.length <= 1) return;

  const map = Object.create(null);
  const clashes = [];

  for (let i = 1; i < data.length; i++) {
    const roll = data[i][0];
    const name = data[i][1];
    const subject = data[i][4];
    const rawDate = data[i][6];
    const session = data[i][7];

    if (!roll || !rawDate || !session) continue;

    let dateKey;
    if (rawDate instanceof Date) {
      dateKey = rawDate.getFullYear() + "-" + (rawDate.getMonth() + 1) + "-" + rawDate.getDate();
    } else {
      dateKey = rawDate.replace(/\//g, "-");
    }

    const key = roll + "|" + dateKey + "|" + session;

    if (!map[key]) {
      map[key] = { roll, name, date: dateKey, session, subjects: [] };
    }
    map[key].subjects.push(subject);
  }

  for (const k in map) {
    if (map[k].subjects.length > 1) {
      clashes.push(map[k]);
    }
  }

  if (clashes.length === 0) {
    SpreadsheetApp.getUi().alert("✅ No exam clashes found");
    return;
  }

  const out = ss.getSheetByName("⚠ Exam_Clashes") || ss.insertSheet("⚠ Exam_Clashes");
  out.clear();

  const result = [["Roll_No", "Name", "Exam_Date", "Session", "Clashing_Subjects"]];
  clashes.forEach(c => result.push([c.roll, c.name, c.date, c.session, c.subjects.join(", ")]));

  out.getRange(1, 1, result.length, result[0].length).setValues(result);
  SpreadsheetApp.getUi().alert(`⚠ ${clashes.length} clash(es) found`);
}

