  row += 2;
  
  const headers = ['Date', 'Session', 'Room No', 'Faculty Name', 'Designation'];
  sheet.getRange(row, 1, 1, headers.length).setValues([headers])
    .setFontWeight('bold').setFontSize(10).setHorizontalAlignment('center')
    .setBackground('#434343').setFontColor('white')
    .setBorder(true, true, true, true, true, true);
  row++;
  
  const allDuties = existingData.map(r => [r[0], r[1], r[2], r[3], r[4]]);
  if (existingData.length > 0 && newDuties.length > 0) {
    allDuties.push([`──────── NEW SESSION: ${newDuties[0].date} | ${newDuties[0].session} ────────`, '', '', '', '']);
  }
  newDuties.forEach(d => allDuties.push([d.date, d.session, d.roomNo, d.facultyName, d.designation]));
  
  if (allDuties.length > 0) {
    sheet.getRange(row, 1, allDuties.length, headers.length).setValues(allDuties)
      .setVerticalAlignment('middle').setBorder(true, true, true, true, true, true);
    if (existingData.length > 0 && newDuties.length > 0) {
      const sepRow = row + existingData.length;
      sheet.getRange(sepRow, 1, 1, headers.length).setBackground('#ffe599').setFontWeight('bold').setFontSize(11).setHorizontalAlignment('center');
      sheet.getRange(sepRow, 1, 1, headers.length).merge();
    }
    for (let i = 0; i < allDuties.length; i++) {
      sheet.getRange(row + i, 1, 1, headers.length).setBackground((i % 2 === 0) ? '#ffffff' : '#f3f3f3');
    }
  }
  
  sheet.setColumnWidth(1, 120);
  sheet.setColumnWidth(2, 100);
  sheet.setColumnWidth(3, 100);
  sheet.setColumnWidth(4, 200);
  sheet.setColumnWidth(5, 150);
  sheet.setFrozenRows(4);
}

function writeFacultySummary(ss, summary) {
  const SHEET_NAME = DUTY_CONFIG.FACULTY_SUMMARY;
  let sheet = ss.getSheetByName(SHEET_NAME);
  if (sheet) ss.deleteSheet(sheet);
  sheet = ss.insertSheet(SHEET_NAME);
  
  let row = 1;
  sheet.getRange(row, 1, 1, 6).merge().setValue('FACULTY DUTY SUMMARY')
    .setFontWeight('bold').setFontSize(14).setHorizontalAlignment('center')
    .setBackground('#6fa8dc').setFontColor('white');
  row++;
  
  sheet.getRange(row, 1, 1, 6).merge().setValue('Generated: ' + new Date().toLocaleString())
    .setFontSize(9).setHorizontalAlignment('center').setBackground('#d9d9d9');
  row += 2;
  
  const headers = ['Faculty Name', 'Employee ID', 'Designation', 'Assigned Duties', 'Max Duties', 'Remaining'];
  sheet.getRange(row, 1, 1, headers.length).setValues([headers])
    .setFontWeight('bold').setFontSize(10).setHorizontalAlignment('center')
    .setBackground('#434343').setFontColor('white')
    .setBorder(true, true, true, true, true, true);
  row++;
  
  if (summary.length > 0) {
    const summaryData = summary.map(s => [s.facultyName, s.empId, s.designation, s.assignedDuties, s.maxDuties, s.remaining]);
    sheet.getRange(row, 1, summaryData.length, headers.length).setValues(summaryData)
      .setVerticalAlignment('middle').setBorder(true, true, true, true, true, true);
    
    for (let i = 0; i < summaryData.length; i++) {
      sheet.getRange(row + i, 1, 1, headers.length).setBackground((i % 2 === 0) ? '#ffffff' : '#f3f3f3');
      if (summary[i].remaining < 0) sheet.getRange(row + i, 6).setBackground('#ff0000').setFontColor('white');
      else if (summary[i].remaining === 0) sheet.getRange(row + i, 6).setBackground('#ffff00');
    }
    row += summaryData.length;
  }
  
  row += 2;
  const totalAssigned = summary.reduce((sum, s) => sum + s.assignedDuties, 0);
  const avgDuties = summary.length > 0 ? (totalAssigned / summary.length).toFixed(2) : 0;
  
  sheet.getRange(row, 1).setValue('STATISTICS').setFontWeight('bold').setBackground('#fff2cc');
  row++;
  const stats = [['Total Faculty Assigned:', summary.length], ['Total Duties:', totalAssigned], ['Average Duties per Faculty:', avgDuties]];
  sheet.getRange(row, 1, stats.length, 2).setValues(stats).setFontWeight('bold').setBackground('#fff2cc');
  
  sheet.setColumnWidth(1, 200);
  sheet.setColumnWidth(2, 120);
  sheet.setColumnWidth(3, 150);
  sheet.setColumnWidth(4, 120);
  sheet.setColumnWidth(5, 100);
  sheet.setColumnWidth(6, 100);
  sheet.setFrozenRows(4);
}

function writeAvailableFacultyList(ss, currentSessionDuties, config, seatingData) {
  const SHEET_NAME = 'Available Faculty List';
  if (!seatingData || seatingData.length === 0) return;
  
  const currentDate = seatingData[0].date, currentSession = seatingData[0].session;
  const assignedFaculty = new Set();
  currentSessionDuties.forEach(duty => { if (duty.date === currentDate && duty.session === currentSession) assignedFaculty.add(duty.facultyName); });
  
  const availableFaculty = Object.values(config.faculty).filter(f => !assignedFaculty.has(f.name) && !config.unavailability[f.name + '|' + currentDate + '|' + currentSession]);
  availableFaculty.sort((a, b) => a.designation !== b.designation ? a.designation.localeCompare(b.designation) : a.name.localeCompare(b.name));
  
  let sheet = ss.getSheetByName(SHEET_NAME);
  if (sheet) ss.deleteSheet(sheet);
  sheet = ss.insertSheet(SHEET_NAME);
  
  let row = 1;
  sheet.getRange(row, 1, 1, 4).merge().setValue('AVAILABLE FACULTY LIST').setFontWeight('bold').setFontSize(14).setHorizontalAlignment('center').setBackground('#93c47d').setFontColor('white');
  row++;
  sheet.getRange(row, 1, 1, 4).merge().setValue('Date: ' + currentDate + ' | Session: ' + currentSession).setFontWeight('bold').setFontSize(11).setHorizontalAlignment('center').setBackground('#b6d7a8').setFontColor('black');
  row++;
  sheet.getRange(row, 1, 1, 4).merge().setValue('Generated: ' + new Date().toLocaleString()).setFontSize(9).setHorizontalAlignment('center').setBackground('#d9d9d9');
  row += 2;
  sheet.getRange(row, 1, 1, 4).merge().setValue('Faculty Available (No Duty): ' + availableFaculty.length).setFontWeight('bold').setFontSize(11).setHorizontalAlignment('center').setBackground('#fff2cc');
  row += 2;
  
  const headers = ['Faculty Name', 'Employee ID', 'Designation', 'Department'];
  sheet.getRange(row, 1, 1, headers.length).setValues([headers]).setFontWeight('bold').setFontSize(10).setHorizontalAlignment('center').setBackground('#434343').setFontColor('white').setBorder(true, true, true, true, true, true);
  row++;
  
  if (availableFaculty.length > 0) {
    const availableData = availableFaculty.map(f => [f.name, f.empId, f.designation, f.department]);
    sheet.getRange(row, 1, availableData.length, headers.length).setValues(availableData).setVerticalAlignment('middle').setBorder(true, true, true, true, true, true);
    for (let i = 0; i < availableData.length; i++) sheet.getRange(row + i, 1, 1, headers.length).setBackground((i % 2 === 0) ? '#d9ead3' : '#ffffff');
    row += availableData.length;
  } else {
    sheet.getRange(row, 1, 1, 4).merge().setValue('All faculty are either assigned duties or unavailable for this session.').setFontStyle('italic').setHorizontalAlignment('center').setBackground('#f4cccc');
    row++;
  }
  
  row += 2;
  sheet.getRange(row, 1).setValue('STATISTICS').setFontWeight('bold').setBackground('#fff2cc');
  row++;
  const stats = [['Total Available Faculty:', availableFaculty.length], ['Faculty on Duty:', assignedFaculty.size], ['Total Registered Faculty:', Object.values(config.faculty).length]];
  sheet.getRange(row, 1, stats.length, 2).setValues(stats).setFontWeight('bold').setBackground('#fff2cc');
  
  sheet.setColumnWidth(1, 200);
  sheet.setColumnWidth(2, 120);
  sheet.setColumnWidth(3, 150);
  sheet.setColumnWidth(4, 180);
  sheet.setFrozenRows(7);
}

