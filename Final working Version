    .setFontWeight('bold')
    .setBackground('#fff2cc')
    .setBorder(true, true, true, true, true, true);
  
  // Highlight warnings
  if (overLimitCount > 0) {
    summarySheet.getRange(row + 5, 2).setBackground('#ff0000').setFontColor('white');
  }
  if (atLimitCount > 0) {
    summarySheet.getRange(row + 6, 2).setBackground('#ffff00');
  }
  
  // Column widths
  summarySheet.setColumnWidth(1, 200);
  summarySheet.setColumnWidth(2, 120);
  summarySheet.setColumnWidth(3, 150);
  summarySheet.setColumnWidth(4, 180);
  summarySheet.setColumnWidth(5, 120);
  summarySheet.setColumnWidth(6, 100);
  summarySheet.setColumnWidth(7, 100);
  
  summarySheet.setFrozenRows(5);
  
  Logger.log('Faculty Summary updated in Drive spreadsheet - showing all ' + allFaculty.length + ' available faculty');
}

